[Unit]
Description=Report verified AXI Wiki deployments to GitHub
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/axi-wiki/report.env
ExecStart=/usr/bin/python3 /opt/axi-wiki/scripts/report-deployment.py
UMask=0077
TimeoutStartSec=5min
